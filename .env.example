# Copy to .env and adjust. .env is gitignored.

# Postgres (matches docker-compose.yml)
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://thyma:thyma@localhost:5432/thyma
TEST_DATABASE_URL=postgresql+psycopg://thyma:thyma@localhost:5432/thyma_test

# Where uploaded PDFs are stored (LocalStorage)
UPLOAD_DIR=uploads

# LLM provider: "fake" until M4
LLM_PROVIDER=fake

# Public demo mode: blocks writes and uploads
READ_ONLY_DEMO=false
